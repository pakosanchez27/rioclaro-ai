# Valores locales; mantener claves reales fuera de Git.
DEMO_MODE=true
AZURE_FUNCTIONS_ENVIRONMENT=Development
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/rioclaro.db
# Para el proveedor Azure: STORAGE_BACKEND=table y la URL HTTPS del servicio Tables.
# AZURE_TABLE_ACCOUNT_URL=https://<cuenta>.table.core.windows.net
# AZURE_TABLE_NAME=RioClaroDemo
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-rioclaro
DOCUMENTINTELLIGENCE_ENDPOINT=
DOCUMENTINTELLIGENCE_API_KEY=
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENABLE_INVOICE_ANALYSIS=true
DEV_MAX_DAILY_INVOICE_ANALYSES=20
ENABLE_ASSISTANT=true
DEV_MAX_DAILY_ASSISTANT_QUESTIONS=100
# Produccion: definir límites independientes al configurar almacenamiento compartido.
# PROD_MAX_DAILY_INVOICE_ANALYSES=
# PROD_MAX_DAILY_ASSISTANT_QUESTIONS=
